{
    "key": "group_stats_showcase_section",
    "title": "Stats Showcase Section",
    "fields": [
        {
            "key": "field_stss_logo_mode",
            "label": "Logo Source",
            "name": "logo_mode",
            "type": "button_group",
            "instructions": "Single: one logo tiled everywhere. Gallery: upload several and they'll alternate across the scrolling columns.",
            "choices": {
                "single": "Single logo",
                "gallery": "Gallery (alternating)"
            },
            "default_value": "single",
            "layout": "horizontal",
            "return_format": "value",
            "wrapper": {
                "width": "100"
            }
        },
        {
            "key": "field_stss_logo",
            "label": "Marquee Logo",
            "name": "logo",
            "type": "image",
            "required": 1,
            "return_format": "array",
            "preview_size": "medium",
            "instructions": "Tiled through the 4 scrolling background columns. Canvas: 440×160px (displays at 220×80px, so upload at 2x for retina) — transparent PNG or SVG. The logo is letterboxed to fit that box, not cropped, so any aspect ratio works as long as the file itself is at least 220×80px.",
            "min_width": 220,
            "min_height": 80,
            "wrapper": {
                "width": "100"
            },
            "conditional_logic": [
                [
                    {
                        "field": "field_stss_logo_mode",
                        "operator": "==",
                        "value": "single"
                    }
                ]
            ]
        },
        {
            "key": "field_stss_logos",
            "label": "Marquee Logos",
            "name": "logos",
            "type": "gallery",
            "return_format": "array",
            "preview_size": "medium",
            "insert": "append",
            "min": 2,
            "instructions": "Tiled through the 4 scrolling background columns — logos alternate as the columns repeat. Canvas: 440×160px per logo (displays at 220×80px, so upload at 2x for retina) — transparent PNG or SVG. Each logo is letterboxed to fit that box, not cropped, so any aspect ratio works as long as the file itself is at least 220×80px.",
            "min_width": 220,
            "min_height": 80,
            "wrapper": {
                "width": "100"
            },
            "conditional_logic": [
                [
                    {
                        "field": "field_stss_logo_mode",
                        "operator": "==",
                        "value": "gallery"
                    }
                ]
            ]
        },
        {
            "key": "field_stss_slides",
            "label": "Slides",
            "name": "slides",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add Slide",
            "min": 1,
            "instructions": "Each slide is a stable state of the shared 4-icon orbit (see stats_showcase_section.js) — advances automatically every ~3.5–4.5s.",
            "sub_fields": [
                {
                    "key": "field_stss_slide_stat",
                    "label": "Stat",
                    "name": "stat",
                    "type": "text",
                    "required": 1,
                    "instructions": "e.g. “100+”",
                    "wrapper": {
                        "width": "33"
                    }
                },
                {
                    "key": "field_stss_slide_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1,
                    "instructions": "Exactly two words — each renders as its own animated line (e.g. “Gaming Providers”).",
                    "wrapper": {
                        "width": "67"
                    }
                },
                {
                    "key": "field_stss_slide_description",
                    "label": "Description",
                    "name": "description",
                    "type": "textarea",
                    "rows": 2,
                    "required": 1,
                    "wrapper": {
                        "width": "100"
                    }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/stats-showcase-section"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
