        {
            "key": "field_scs_after_label",
            "label": "After Label",
            "name": "after_label",
            "type": "text",
            "required": 1,
            "instructions": "e.g. “Custom-built lobby”",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_scs_before_image",
