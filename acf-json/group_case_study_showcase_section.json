{
    "key": "group_case_study_showcase_section",
    "title": "Case Study Showcase Section",
    "fields": [
        {
            "key": "field_css2_title",
            "label": "Title",
            "name": "title",
            "type": "text",
            "required": 1,
            "instructions": "e.g. “A front-end built to be BoxBet’s own”",
            "wrapper": {
                "width": "100"
            }
        },
        {
            "key": "field_css2_images",
            "label": "Images",
            "name": "images",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add Image",
            "instructions": "Full Width shows on its own row. Half Width pairs up with the next Half Width image side by side (an odd one out falls back to full width).",
            "sub_fields": [
                {
                    "key": "field_css2_image",
                    "label": "Image",
                    "name": "image",
                    "type": "image",
                    "required": 1,
                    "return_format": "array",
                    "preview_size": "medium",
                    "wrapper": {
                        "width": "70"
                    }
                },
                {
                    "key": "field_css2_image_width",
                    "label": "Width",
                    "name": "width",
                    "type": "select",
                    "choices": {
                        "full": "Full Width",
                        "half": "Half Width"
                    },
                    "default_value": "full",
                    "allow_null": 0,
                    "ui": 1,
                    "wrapper": {
                        "width": "30"
                    }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/case-study-showcase-section"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
