{
    "key": "group_case_study_screens_section",
    "title": "Case Study Screens Section",
    "fields": [
        {
            "key": "field_cscs_title",
            "label": "Title",
            "name": "title",
            "type": "text",
            "required": 1,
            "instructions": "e.g. “Mobile-first, like every casino has to be”",
            "wrapper": {
                "width": "100"
            }
        },
        {
            "key": "field_cscs_description",
            "label": "Description",
            "name": "description",
            "type": "textarea",
            "rows": 3,
            "wrapper": {
                "width": "100"
            }
        },
        {
            "key": "field_cscs_images",
            "label": "Screens",
            "name": "images",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add Screen",
            "instructions": "Full Width shows on its own row. Half Width pairs up with the next Half Width screen side by side (an odd one out falls back to full width).",
            "sub_fields": [
                {
                    "key": "field_cscs_image_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text",
                    "required": 1,
                    "instructions": "e.g. “Lobby”",
                    "wrapper": {
                        "width": "34"
                    }
                },
                {
                    "key": "field_cscs_image",
                    "label": "Image",
                    "name": "image",
                    "type": "image",
                    "required": 1,
                    "return_format": "array",
                    "preview_size": "medium",
                    "wrapper": {
                        "width": "36"
                    }
                },
                {
                    "key": "field_cscs_image_width",
                    "label": "Width",
                    "name": "width",
                    "type": "select",
                    "choices": {
                        "full": "Full Width",
                        "half": "Half Width"
                    },
                    "default_value": "full",
                    "allow_null": 0,
                    "ui": 1,
                    "wrapper": {
                        "width": "30"
                    }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/case-study-screens-section"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
