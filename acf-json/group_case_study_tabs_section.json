                    }
                },
                {
                    "key": "field_csts_tab_image",
                    "label": "Image",
                    "name": "image",
                    "type": "image",
                    "required": 1,
                    "return_format": "array",
                    "preview_size": "medium",
                    "wrapper": {
                        "width": "50"
                    }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/case-study-tabs-section"
            }
        ]
    ],
    "menu_order": 0,
